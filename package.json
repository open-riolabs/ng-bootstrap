{
  "name": "ng-bootstrap",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4201",
    "build": "ng build",
    "build:docs": "ng build ng-bootstrap --base-href /ng-bootstrap/ && node scripts/prepare-pages.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lib:build": "ng build @open-rlb/ng-bootstrap && npm run lib:build:schematics",
    "lib:build:schematics": "node scripts/build-schematics.mjs",
    "lib:test:ng-add": "node scripts/test-ng-add.cjs",
    "lib:test": "ng test @open-rlb/ng-bootstrap",
    "lib:test-ci": "ng test @open-rlb/ng-bootstrap --no-watch --no-progress",
    "lib:lint": "ng lint @open-rlb/ng-bootstrap",
    "lib:pack": "npm run lib:build && npm pack ./dist/rlb/ng-bootstrap && node scripts/verify-pack.cjs",
    "pretty": "prettier --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json,html}\"",
    "http": "http-server ./dist/ng-bootstrap -p 4001 -c-1 --cors -U --log-ip",
    "test-ci": "ng test ng-bootstrap --no-watch --no-progress"
  },
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "author": {
    "name": "Giusseppe Riolo",
    "email": "riolo.giuseppe@gmail.com",
    "url": "https://github.com/riologiuseppe"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/riolabs/common/libraries/rlb-ng-bootstrap"
  },
  "dependencies": {
    "@angular/animations": "^21.1.2",
    "@angular/cdk": "^21.1.2",
    "@angular/common": "^21.1.2",
    "@angular/compiler": "^21.1.2",
    "@angular/core": "^21.1.2",
    "@angular/forms": "^21.1.2",
    "@angular/platform-browser": "^21.1.2",
    "@angular/platform-browser-dynamic": "^21.1.2",
    "@angular/router": "^21.1.2",
    "@ngx-translate/core": "^17.0.0",
    "@open-rlb/date-tz": ">=2.0.1",
    "bootstrap": "^5.3.7",
    "bootstrap-icons": "^1.13.1",
    "ngx-highlightjs": "^14.0.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/core": "^21.1.5",
    "@angular-devkit/schematics": "^21.1.5",
    "@angular/build": "^21.1.2",
    "@angular/cli": "~21.1.2",
    "@angular/compiler-cli": "^21.1.2",
    "@angular/localize": "^21.1.2",
    "@schematics/angular": "^21.1.5",
    "@types/bootstrap": "^5.2.10",
    "@types/node": "^24.0.13",
    "http-server": "^14.1.1",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.1.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "vitest": "^4.0.18"
  }
}
